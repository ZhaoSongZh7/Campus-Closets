# Postgres connection string (Neon, Supabase, or local).
# Neon: use the "pooled" connection string.  Supabase: use the "Transaction pooler" string.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Optional: the email of an account that should own the sample listings (instead of the sample lenders).
# Sign up with it first, then run `npm run db:setup`.
# SAMPLE_OWNER_EMAIL="you@example.com"
